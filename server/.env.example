PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database configuration:
# For SQLite (default for instant zero-config dev):
DATABASE_URL="file:./dev.db"

# For PostgreSQL (production or local Postgres instance):
